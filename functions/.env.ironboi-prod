# Non-secret environment config for the ironboi-prod project.
# Loaded automatically by firebase-tools at
#   firebase deploy --only functions,firestore --project ironboi-prod
# Mirrors .env.ironboi-staging on purpose: prod should run exactly what the
# nightly E2E proves on staging. Without this file a prod deploy would get the
# tool loop OFF and an unpinned provider. See that file for the reasoning and
# rollback notes behind each line.
#
# Secrets (GEMINI_API_KEY, OPENROUTER_API_KEY) stay in Secret Manager — set
# both on the prod project before the first deploy:
#   firebase functions:secrets:set OPENROUTER_API_KEY --project ironboi-prod
#   firebase functions:secrets:set GEMINI_API_KEY --project ironboi-prod
# This file is TRACKED IN GIT; never put a key here.

IRONBOI_COACH_PROVIDER=openrouter
# IRONBOI_OPENROUTER_MODEL=google/gemini-2.5-flash

IRONBOI_COACH_TOOL_LOOP_ENABLED=true

# App Check enforcement. Turn on once App Attest is registered for the prod
# app in the Firebase console — docs/operations/appcheck-enable-runbook.md.
# IRONBOI_ENFORCE_APP_CHECK=true
