# Non-secret environment config for the ironboi-staging project.
# Loaded automatically by firebase-tools at `firebase deploy --only functions`.
# Secrets (GEMINI_API_KEY, OPENROUTER_API_KEY) stay in Secret Manager via
# defineSecret — never here. This file is TRACKED IN GIT; a key added here
# would be pushed to GitHub.

# Which vendor serves the coach turn. Pinned rather than left to the
# selector's default so the choice is declared, reviewable, and can't drift
# silently when a key is added or removed.
#
# OpenRouter as of 2026-07-26: one balance across every model instead of a
# per-project Google quota (MYO Fitness sat on the free tier, and the 429s
# that produced were misdiagnosed twice during live E2E). Model is chosen
# separately via IRONBOI_OPENROUTER_MODEL, default google/gemini-2.5-flash —
# i.e. the same model as before, so this switch is transport-only.
#
# ROLLBACK: set to `gemini` and run a FULL
#   firebase deploy --only functions --project ironboi-staging
# A pin whose key is missing returns NO provider and logs
# coach_provider_key_missing — it will not quietly bill the other vendor.
IRONBOI_COACH_PROVIDER=openrouter

# Model id, OpenRouter-namespaced. Switching vendors/models is this one line.
# IRONBOI_OPENROUTER_MODEL=google/gemini-2.5-flash

# Gemini function-calling tool loop (adapt_plan / accept / reject /
# ask_follow_up_question). ON for staging as of 2026-07-14. When this is
# false/absent the coach falls back to the deterministic keyword classifier
# and the LLM turn is a plain single-call reply.
#
# ROLLBACK: flip this line to false and run a FULL
#   firebase deploy --only functions --project ironboi-staging
# Never flip it per-service with `gcloud run services update` — the flag
# gates BOTH sides of the switchover across three services
# (onUserCoachMessageCreated, sendCoachMessage, sendCoachMessageHttp);
# flipping one creates a split-brain (no proposals at all, or duplicates),
# and the next firebase deploy silently clobbers gcloud-set env anyway.
IRONBOI_COACH_TOOL_LOOP_ENABLED=true

# App Check enforcement on the onCall surface. OFF while absent. Do NOT set
# this to true until the console prerequisites are done (App Attest
# registration + debug tokens) — full checklist in
# docs/operations/appcheck-enable-runbook.md.
#
# ROLLBACK / FLIP: add or remove the line below and run a FULL
#   firebase deploy --only functions --project ironboi-staging
# Never flip it per-service with `gcloud run services update` — the flag
# gates every callable across all services; flipping one creates a
# split-brain, and the next firebase deploy silently clobbers gcloud-set
# env anyway.
# IRONBOI_ENFORCE_APP_CHECK=true
